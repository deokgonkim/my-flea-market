{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@repo/dynamodb-manager": ["../dynamodb-manager/src/index.ts"],
      "@repo/telegram": ["../telegram/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../dynamodb-manager" },
    { "path": "../telegram" }
  ]
}
