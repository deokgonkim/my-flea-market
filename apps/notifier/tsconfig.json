{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false, /* Allow unused parameters for lambda handlers */
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true, /* allow class-validator decorators */
    "paths": {
      "@repo/models": ["../../packages/models/src/index.ts"],
      "@repo/service": ["../../packages/service/src/index.ts"],
      "@repo/telegram": ["../../packages/telegram/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/__tests__/**"],
  "references": [
    { "path": "../../packages/models" },
    { "path": "../../packages/service" },
    { "path": "../../packages/telegram" }
  ]
}
